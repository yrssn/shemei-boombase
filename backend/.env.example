# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 登录账号，格式 user:password，多个用英文逗号分隔
APP_USERS=admin:admin123,ops:ops123

# 允许的前端来源（CORS），多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 企业微信（写回文档）
WECOM_CORP_ID=
WECOM_CORP_SECRET=
# 智能表格文档 ID 与子表 ID
WECOM_DOCID=
WECOM_SHEET_ID=
# 智能表格的字段标题（需与表格列名一致）
WECOM_FIELD_LINK=帖子链接
WECOM_FIELD_CAPTION=原始文案
WECOM_FIELD_AUTHOR=作者
WECOM_FIELD_SENTIMENT=情绪
WECOM_FIELD_OPERATOR=提交人

# 可选：抓取 Instagram 时使用的代理，如 http://127.0.0.1:7890
HTTP_PROXY_URL=
# SQLite 历史记录文件
DATABASE_PATH=./data.db
